\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Task~A row construction on a single anchor study. Green-titled rows are positives (clean and scan-like image, respectively). Red-titled rows are the five negative types. Each row's three columns show which study contributed the signal, the image, and the text; \texttt  {TEXT\_SWAP} only changes the text source, \texttt  {IMAGE\_SWAP} only changes the image source, etc. \texttt  {HARD\_NEGATIVE\_TEXT} swaps text from a study in the same HR bucket, so heart-rate alone cannot solve the task.}}{11}{figure.caption.25}\protected@file@percent }
\newlabel{fig:taskA_negatives}{{13}{11}{Task~A row construction on a single anchor study. Green-titled rows are positives (clean and scan-like image, respectively). Red-titled rows are the five negative types. Each row's three columns show which study contributed the signal, the image, and the text; \texttt {TEXT\_SWAP} only changes the text source, \texttt {IMAGE\_SWAP} only changes the image source, etc. \texttt {HARD\_NEGATIVE\_TEXT} swaps text from a study in the same HR bucket, so heart-rate alone cannot solve the task}{figure.caption.25}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Heart-rate buckets used to construct \texttt  {HARD\_NEGATIVE\_TEXT} rows. Studies are partitioned into four buckets (\texttt  {brady}, \texttt  {normal\_low}, \texttt  {normal\_high}, \texttt  {tachy}) using the cut-points marked in Figure~\ref {fig:hr_distribution}; the hard-negative text is sampled from a study in the \emph  {same} bucket as the anchor.}}{12}{figure.caption.26}\protected@file@percent }
\newlabel{fig:hr_bucket_logic}{{14}{12}{Heart-rate buckets used to construct \texttt {HARD\_NEGATIVE\_TEXT} rows. Studies are partitioned into four buckets (\texttt {brady}, \texttt {normal\_low}, \texttt {normal\_high}, \texttt {tachy}) using the cut-points marked in Figure~\ref {fig:hr_distribution}; the hard-negative text is sampled from a study in the \emph {same} bucket as the anchor}{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Task~A negative-type and positive/negative distribution computed from \texttt  {processed/taskA\_stats.json}. The five negative types are nearly equal in size because each is generated once per study; \texttt  {HARD\_NEGATIVE\_TEXT} is the only exception, missing $187$ rows that correspond to the studies whose RR interval is invalid and therefore cannot be assigned a HR bucket.}}{12}{figure.caption.27}\protected@file@percent }
\newlabel{fig:taskA_distribution}{{15}{12}{Task~A negative-type and positive/negative distribution computed from \texttt {processed/taskA\_stats.json}. The five negative types are nearly equal in size because each is generated once per study; \texttt {HARD\_NEGATIVE\_TEXT} is the only exception, missing $187$ rows that correspond to the studies whose RR interval is invalid and therefore cannot be assigned a HR bucket}{figure.caption.27}{}}
\@writefile{toc}{\contentsline {paragraph}{Local detection logic.}{12}{section*.29}\protected@file@percent }
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Task~B label fix. Left: per-query count of studies with at least one positive bin, before vs after the fix. Under the old global-RR rule, \texttt  {LOW\_HEART\_RATE} and \texttt  {WIDE\_QRS} produced exactly zero positive rows because the rule only checked $\text  {HR}>100$. After the fix, all three queries produce realistic positive counts that match the underlying physiology. Right: the post-fix per-bin positive fraction for the three queries; the non-uniform pattern across bins is the visual proof that local detection (rather than a global stamp) drives the labels.}}{13}{figure.caption.30}\protected@file@percent }
\newlabel{fig:taskB_local}{{16}{13}{Task~B label fix. Left: per-query count of studies with at least one positive bin, before vs after the fix. Under the old global-RR rule, \texttt {LOW\_HEART\_RATE} and \texttt {WIDE\_QRS} produced exactly zero positive rows because the rule only checked $\text {HR}>100$. After the fix, all three queries produce realistic positive counts that match the underlying physiology. Right: the post-fix per-bin positive fraction for the three queries; the non-uniform pattern across bins is the visual proof that local detection (rather than a global stamp) drives the labels}{figure.caption.30}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Task~B per-bin positive count per query (computed by streaming \texttt  {taskB\_temporal\_grounding.jsonl}; total studies $=799{,}706$). The non-uniform within-query pattern across the ten bins is the quantitative counterpart of Figure~\ref {fig:taskB_local} and rules out the trivial all-bins-equal degenerate solution.}}{13}{table.caption.33}\protected@file@percent }
\newlabel{tab:taskB_perbin}{{1}{13}{Task~B per-bin positive count per query (computed by streaming \texttt {taskB\_temporal\_grounding.jsonl}; total studies $=799{,}706$). The non-uniform within-query pattern across the ten bins is the quantitative counterpart of Figure~\ref {fig:taskB_local} and rules out the trivial all-bins-equal degenerate solution}{table.caption.33}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Task~B local detection on three real cleaned studies, one per query. Each panel overlays the per-bin label vector on the Lead~II waveform; bins labelled $1$ are shaded green. \textbf  {Top:} \texttt  {HIGH\_HEART\_RATE} study with a sustained tachycardic run --- bins 1--7 fire because the local instantaneous HR exceeds $100$~bpm there, while bins 0 and 8--9 stay $0$ where the rhythm is at or below the threshold. \textbf  {Middle:} \texttt  {LOW\_HEART\_RATE} study where the rate slows after roughly $3$~s and remains bradycardic for the rest of the strip, so bins 3--9 fire and the early bins stay $0$. \textbf  {Bottom:} \texttt  {WIDE\_QRS} study where wide-QRS beats appear from bin 2 through bin 8 (the wavelet delineator measures QRS duration $>120$~ms for those beats), and the very first and last bins do not fire because their beats either had borderline-narrow QRS or the delineator returned NaN boundaries. The old global rule would have collapsed each panel to all-zero or all-one; the per-bin patterns shown here are what makes the labels useful for temporal-grounding training.}}{14}{figure.caption.31}\protected@file@percent }
\newlabel{fig:taskB_examples}{{17}{14}{Task~B local detection on three real cleaned studies, one per query. Each panel overlays the per-bin label vector on the Lead~II waveform; bins labelled $1$ are shaded green. \textbf {Top:} \texttt {HIGH\_HEART\_RATE} study with a sustained tachycardic run --- bins 1--7 fire because the local instantaneous HR exceeds $100$~bpm there, while bins 0 and 8--9 stay $0$ where the rhythm is at or below the threshold. \textbf {Middle:} \texttt {LOW\_HEART\_RATE} study where the rate slows after roughly $3$~s and remains bradycardic for the rest of the strip, so bins 3--9 fire and the early bins stay $0$. \textbf {Bottom:} \texttt {WIDE\_QRS} study where wide-QRS beats appear from bin 2 through bin 8 (the wavelet delineator measures QRS duration $>120$~ms for those beats), and the very first and last bins do not fire because their beats either had borderline-narrow QRS or the delineator returned NaN boundaries. The old global rule would have collapsed each panel to all-zero or all-one; the per-bin patterns shown here are what makes the labels useful for temporal-grounding training}{figure.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Task~B per-query positive rate (left, fraction of studies with any positive bin) and per-bin positive fraction (right) computed by streaming the final \texttt  {taskB\_temporal\_grounding.jsonl}. The per-bin fractions vary within each query, indicating real temporal information.}}{14}{figure.caption.32}\protected@file@percent }
\newlabel{fig:taskB_distribution}{{18}{14}{Task~B per-query positive rate (left, fraction of studies with any positive bin) and per-bin positive fraction (right) computed by streaming the final \texttt {taskB\_temporal\_grounding.jsonl}. The per-bin fractions vary within each query, indicating real temporal information}{figure.caption.32}{}}
